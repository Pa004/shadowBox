{
  "$schema": "node_modules/wrangler/config-schema.json",
  // M4b scaffold: fill database_id after `wrangler d1 create shadowbox`.
  "name": "shadowbox-api",
  "main": "apps/api/worker.py",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./apps/web/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shadowbox",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE"
    }
  ]
}
