{
  "$schema": "node_modules/wrangler/config-schema.json",
  // D1 database `shadowbox` (ENAM). Binding DB matches the Worker's store lookup.
  "name": "shadowbox-api",
  "main": "apps/api/worker.py",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./apps/web/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shadowbox",
      "database_id": "13323bef-4a4a-4392-b5e8-ef3412ef02ad"
    }
  ]
}
